# Optional external text recognition. Never put this key in NEXT_PUBLIC_*.
GOOGLE_VISION_API_KEY=
OCR_DISABLED=true
# Comma-separated verified platform account emails. Blank denies every admin.
ADMIN_EMAILS=

# Manual crawler. Keep every token server-side/GitHub Actions only.
CRAWLER_CONTACT_URL=https://github.com/kimyounggaur/Synthesizer_Edu/issues
CRAWLER_INGEST_URL=
CRAWLER_INGEST_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
